---
import FadeIn from './FadeIn.astro';
import { Zap, Smartphone, Search, MessageCircle, Shield, BarChart2 } from '@lucide/astro';

const techBadges = ['Astro', 'React', 'Tailwind CSS', 'HTML5', 'CSS3', 'JavaScript', 'TypeScript', 'Git', 'Figma', 'Node.js'];

const benefits = [
  { icon: 'Zap', title: 'Velocidade Extrema', desc: 'Carregamento em menos de 2 segundos. Nota 95+ no Google PageSpeed Insights.' },
  { icon: 'Smartphone', title: '100% Responsivo', desc: 'Perfeito em celulares, tablets e desktops. Mobile-first por padrão.' },
  { icon: 'Search', title: 'Otimizado para SEO', desc: 'Estrutura técnica correta para ser encontrado no Google organicamente.' },
  { icon: 'MessageCircle', title: 'Integração Direta', desc: 'Botões de WhatsApp, formulários inteligentes e captura de leads automatizada.' },
  { icon: 'Shield', title: 'Segurança e HTTPS', desc: 'Certificado SSL, domínio profissional e hospedagem confiável inclusos.' },
  { icon: 'BarChart2', title: 'Métricas e Analytics', desc: 'Google Analytics e Tag Manager configurados para acompanhar resultados reais.' },
];

const IconMap = { Zap, Smartphone, Search, MessageCircle, Shield, BarChart2 };
---

<section id="diferenciais" class="py-24 border-t border-zinc-800/50">
  <div class="max-w-6xl mx-auto px-5">
    <div class="grid lg:grid-cols-2 gap-16 items-start">
      <FadeIn>
        <div class="lg:sticky lg:top-24">
          <span class="section-label">Diferenciais</span>
          <h2 class="text-3xl sm:text-4xl font-bold text-zinc-100 mt-2 mb-6">
            Tecnologia de Ponta e Foco no Seu Negócio
          </h2>
          <p class="text-zinc-400 mb-8 leading-relaxed">
            Não uso construtores de site genéricos. Cada projeto é codificado do zero com as
            melhores tecnologias do mercado, garantindo performance, segurança e resultados reais.
          </p>
          <div class="flex flex-wrap gap-2">
            {techBadges.map((b) => <span class="badge">{b}</span>)}
          </div>
        </div>
      </FadeIn>

      <div class="grid sm:grid-cols-2 gap-4 h-full">
        {benefits.map((b, i) => {
          const Icon = IconMap[b.icon as keyof typeof IconMap];
          return (
            <FadeIn delay={i * 60}>
              <!-- h-full e flex flex-col garantem altura igual e alinhamento interno -->
              <div class="rounded-2xl border border-zinc-800 bg-zinc-900/40 p-5 hover:border-purple-500/30 transition-all h-full flex flex-col">
                <span class="mb-3 block">
                  <Icon class="text-purple-400" size={20} />
                </span>
                <h4 class="font-semibold text-zinc-200 mb-1.5">{b.title}</h4>
                <!-- mt-auto empurra a descrição para o fundo do card -->
                <p class="text-xs text-zinc-500 leading-relaxed mt-auto">{b.desc}</p>
              </div>
            </FadeIn>
          );
        })}
      </div>
    </div>
  </div>
</section>