---
import FadeIn from './FadeIn.astro';
import { Zap, MonitorSmartphone, RefreshCcw, Check, ArrowRight } from '@lucide/astro';

const WA_LINK = 'https://wa.me/5500000000000?text=Olá! Gostaria de solicitar um orçamento.';

const services = [
  {
    icon: 'Zap',
    badge: 'Mais Popular',
    title: 'Landing Pages de Alta Conversão',
    desc: 'Foco total em uma única ação — clique no WhatsApp ou formulário. Ideal para campanhas de tráfego pago.',
    highlights: ['Design focado em 1 CTA', 'Integração com WhatsApp', 'A/B test-ready', 'Entrega em 5–7 dias'],
  },
  {
    icon: 'MonitorSmartphone',
    badge: null,
    title: 'Sites Institucionais',
    desc: 'Presença digital completa com múltiplas páginas para transmitir autoridade. Perfeito para Advogados, Clínicas e Contadores.',
    highlights: ['Múltiplas páginas', 'Blog integrado', 'SEO técnico completo', 'Painel de edição'],
  },
  {
    icon: 'RefreshCcw',
    badge: null,
    title: 'Modernização de Sites',
    desc: 'Reformulamos seu site atual para ser rápido, responsivo e amigável ao SEO sem perder o histórico já conquistado.',
    highlights: ['Migração sem perda de SEO', 'Performance 90+ PageSpeed', 'Design contemporâneo', 'Mobile-first'],
  },
];

const IconMap = { Zap, MonitorSmartphone, RefreshCcw };
---

<section id="servicos" class="py-24 border-t border-zinc-800/50">
  <div class="max-w-6xl mx-auto px-5">
    <FadeIn>
      <div class="text-center mb-14">
        <span class="section-label">Serviços</span>
        <h2 class="text-3xl sm:text-4xl font-bold text-zinc-100 mt-2">
          Soluções Digitais que Geram Resultados Reais
        </h2>
        <p class="mt-4 text-zinc-400 max-w-xl mx-auto">
          Cada projeto é desenvolvido com tecnologia de ponta e foco absoluto em conversão.
        </p>
      </div>
    </FadeIn>

    <div class="grid md:grid-cols-3 gap-6">
      {services.map((s, i) => {
        const Icon = IconMap[s.icon as keyof typeof IconMap];
        return (
          <FadeIn delay={i * 100}>
            <article class="relative h-full rounded-2xl border border-zinc-800 bg-zinc-900/40 p-7 flex flex-col hover:border-purple-500/30 transition-all group">
              {s.badge && (
                <div class="absolute -top-3 left-6">
                  <span class="px-3 py-1 rounded-full bg-purple-600 text-white text-xs font-semibold">{s.badge}</span>
                </div>
              )}
              <div class="w-10 h-10 rounded-xl bg-purple-500/10 border border-purple-500/20 flex items-center justify-center text-purple-400 mb-5">
                <Icon size={20} />
              </div>
              <h3 class="font-bold text-zinc-100 text-lg mb-3 leading-snug">{s.title}</h3>
              <p class="text-sm text-zinc-400 leading-relaxed mb-6">{s.desc}</p>
              <ul class="mt-auto space-y-2">
                {s.highlights.map((h) => (
                  <li class="flex items-center gap-2 text-sm text-zinc-400">
                    <Check class="text-purple-400 flex-shrink-0" size={13} stroke-width={2.5} />
                    {h}
                  </li>
                ))}
              </ul>
              <a href={WA_LINK} target="_blank" rel="noopener noreferrer"
                 class="mt-6 flex items-center gap-1.5 text-sm text-purple-400 font-medium hover:text-purple-300 transition-colors group-hover:gap-2.5">
                Solicitar orçamento
                <ArrowRight size={14} />
              </a>
            </article>
          </FadeIn>
        );
      })}
    </div>
  </div>
</section>