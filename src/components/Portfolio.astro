---
import FadeIn from './FadeIn.astro';
import { ExternalLink } from '@lucide/astro';

const projects = [
  {
    title: "Interface de Matrícula",
    description: "Matrículas para instituições de ensino e escolha de cursos, ofertas etc.",
    image: "/assets/interface.webp",
    tags: ["JavaScript", "Tailwind", "API"],
    github: "https://github.com/victor-feitosaa/interface-de-matricula",
    live: "https://interface-de-matricula.vercel.app/localidadesMult.html"
  },
  {
    title: "Kambordados",
    description: "Landing page personalizada para artista Kambordados expor seus trabalhos e entrarem em contato com a mesma.",
    image: "/assets/kambordados.webp",
    tags: ["React", "Tailwind", "Figma"],
    github: "https://github.com/victor-feitosaa/kambordados",
    live: "https://kambordados.vercel.app"
  }
];
---

<section id="portfolio" class="py-24 border-t border-zinc-800/50">
  <div class="max-w-6xl mx-auto px-5">
    
    <!-- Cabeçalho da Seção (estilo original) -->
    <FadeIn>
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-14">
        <div>
          <span class="section-label">Portfólio</span>
          <h2 class="text-3xl sm:text-4xl font-bold text-zinc-100 mt-2">Projetos Recentes</h2>
        </div>
        <a
          href="https://github.com/victor-feitosaa"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 text-sm text-zinc-400 hover:text-zinc-200 transition-colors"
        >
          <img src="/assets/github.webp" alt="GitHub" class="w-4 h-4" />
          Ver todos no GitHub
        </a>
      </div>
    </FadeIn>

    <!-- Grid de Cards -->
    <div class="grid md:grid-cols-2 gap-8 max-w-5xl mx-auto">
      {projects.map((project, i) => (
        <FadeIn delay={i * 100}>
          <article class="group bg-zinc-900 border border-zinc-700 rounded-2xl shadow-lg flex flex-col justify-between  transition-transform duration-300 h-full">
            
            <!-- Área da Imagem do Projeto (altura aumentada) -->
            <div class="relative bg-purple-600/10 w-full flex justify-center items-center p-4 rounded-t-2xl h-72 overflow-hidden">
              <img
                src={project.image}
                alt={project.title}
                loading="lazy"
                class="h-full w-full object-cover rounded-lg shadow-md group-hover:scale-105 transition-transform duration-300"
              />
            </div>

            <!-- Tecnologias -->
            <div class="flex flex-wrap gap-2 mt-4 px-5">
              {project.tags.map((tag) => (
                <span class="px-2.5 py-1 rounded-md bg-zinc-800 border border-zinc-700 text-xs text-zinc-300 font-medium">
                  {tag}
                </span>
              ))}
            </div>

            <!-- Título e Descrição -->
            <div class="p-5 flex-1">
              <h3 class="text-xl font-bold text-zinc-100">{project.title}</h3>
              <p class="text-zinc-400 mt-2 text-sm leading-relaxed">{project.description}</p>
            </div>

            <!-- Divisória -->
            <hr class="mx-5 border-zinc-700" />

            <!-- Botões de Ação -->
            <div class="w-full flex gap-3 my-4 px-5 pb-5">
              <a
                href={project.github}
                target="_blank"
                rel="noopener noreferrer"
                class="flex-1 flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg bg-zinc-800 hover:bg-zinc-700 text-zinc-200 text-sm font-medium transition-colors border border-zinc-700 hover:border-zinc-600"
              >
                <img src="/assets/github.webp" alt="GitHub" class="w-5 h-5" />
                Código
              </a>
              <a
                href={project.live}
                target="_blank"
                rel="noopener noreferrer"
                class="flex-1 flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg bg-purple-600 hover:bg-purple-500 text-white text-sm font-medium transition-colors shadow-lg shadow-purple-600/20"
              >
                <ExternalLink size={16} />
                Ver Projeto
              </a>
            </div>

          </article>
        </FadeIn>
      ))}
    </div>



  </div>
</section>