---
import FadeIn from './FadeIn.astro';
const WA_LINK = 'https://wa.me/556899423231?text=Olá! Gostaria de solicitar um orçamento.';
---

<section id="hero" class="relative min-h-screen flex items-center overflow-hidden pt-16">
  <div class="absolute inset-0 opacity-[0.03]"
       style="background-image: linear-gradient(#fff 1px,transparent 1px),linear-gradient(90deg,#fff 1px,transparent 1px); background-size: 60px 60px;" />
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/3 w-[700px] h-[700px] rounded-full opacity-10"
         style="background: radial-gradient(circle, #a855f7 0%, transparent 70%)" />
  </div>

  <div class="relative max-w-6xl mx-auto px-5 py-24 grid md:grid-cols-2 gap-16 items-center w-full">
    <div>
      <FadeIn>
        <div class="flex items-center gap-2 mb-6">
          <span class="w-2 h-2 rounded-full bg-purple-400 animate-pulse" />
          <span class="text-xs text-purple-400 font-mono font-medium tracking-wider uppercase">
            Disponível para novos projetos
          </span>
        </div>
      </FadeIn>

      <FadeIn delay={80}>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-zinc-100 leading-[1.1] tracking-tight mb-6">
          Transforme visitantes em <span class="text-purple-400">clientes</span> com um site de alta conversão.
        </h1>
      </FadeIn>

      <FadeIn delay={160}>
        <p class="text-lg text-zinc-400 leading-relaxed mb-8 max-w-lg">
          Seu negócio merece mais do que apenas um Instagram. Desenvolvo
          <strong class="text-zinc-200 font-medium"> Landing Pages</strong> e
          <strong class="text-zinc-200 font-medium"> Sites Institucionais</strong> rápidos,
          otimizados para o Google e projetados para gerar leads direto no seu WhatsApp.
        </p>
      </FadeIn>

      <FadeIn delay={240}>
        <div class="flex flex-wrap gap-3">
          <a href={WA_LINK} target="_blank" rel="noopener noreferrer" class="btn-primary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
            Quero um Site Profissional
          </a>
          <a href="#portfolio" class="btn-outline">
            Ver Projetos
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
          </a>
        </div>
      </FadeIn>

      <FadeIn delay={320}>
        <div class="mt-10 flex flex-wrap gap-6 text-sm text-zinc-500">
          <span class="flex items-center gap-1.5">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#a855f7" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
            Entrega em 7 dias
          </span>
          <span class="flex items-center gap-1.5">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#a855f7" stroke-width="2"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
            100% Responsivo
          </span>
          <span class="flex items-center gap-1.5">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#a855f7" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            SEO Otimizado
          </span>
        </div>
      </FadeIn>
    </div>

    <FadeIn delay={200}>
      <div class="relative flex justify-center items-center">
        <div class="relative w-full max-w-sm mx-auto">
          <div class="rounded-2xl border border-zinc-700/60 bg-zinc-900/80 backdrop-blur p-3 shadow-2xl shadow-black/60">
            <div class="flex items-center gap-1.5 mb-3">
              <span class="w-2.5 h-2.5 rounded-full bg-red-500/70" />
              <span class="w-2.5 h-2.5 rounded-full bg-yellow-500/70" />
              <span class="w-2.5 h-2.5 rounded-full bg-purple-500/70" />
              <div class="flex-1 ml-2 h-5 rounded-md bg-zinc-800 flex items-center px-2">
                <span class="text-[10px] text-zinc-500 font-mono">seusite.com.br</span>
              </div>
            </div>
            <div class="rounded-lg bg-zinc-950 overflow-hidden aspect-[16/10] flex flex-col">
              <div class="bg-zinc-900 h-8 flex items-center px-4 gap-4 border-b border-zinc-800">
                <div class="w-12 h-2 rounded bg-zinc-600" />
                <div class="w-8 h-2 rounded bg-zinc-700" />
                <div class="w-10 h-2 rounded bg-zinc-700" />
                <div class="ml-auto w-16 h-5 rounded-md bg-purple-600/50" />
              </div>
              <div class="flex-1 p-4 flex flex-col gap-3">
                <div class="w-3/4 h-4 rounded bg-zinc-700" />
                <div class="w-1/2 h-3 rounded bg-zinc-800" />
                <div class="w-2/3 h-3 rounded bg-zinc-800" />
                <div class="mt-2 flex gap-2">
                  <div class="w-20 h-7 rounded-lg bg-purple-600/60" />
                  <div class="w-16 h-7 rounded-lg bg-zinc-800" />
                </div>
                <div class="mt-auto grid grid-cols-3 gap-2">
                  {[1, 2, 3].map((i) => <div key={i} class="rounded-lg bg-zinc-800/80 aspect-square" />)}
                </div>
              </div>
            </div>
          </div>
          <div class="absolute -top-4 -left-4 bg-zinc-900 border border-zinc-700 rounded-xl px-3 py-2 shadow-xl flex items-center gap-2">
            <span class="text-purple-400 text-lg font-bold">98</span>
            <div>
              <div class="text-[10px] text-zinc-300 font-semibold leading-none">Performance</div>
              <div class="text-[9px] text-zinc-500">Google PageSpeed</div>
            </div>
          </div>
        </div>
      </div>
    </FadeIn>
  </div>
</section>